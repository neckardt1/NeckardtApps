{
  "name": "neckardt-apps",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/recall"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && npm --workspace apps/recall run typecheck",
    "test": "node --test tests/*.test.mjs && vitest run && npm --workspace apps/recall test",
    "build": "node scripts/build-pages.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
