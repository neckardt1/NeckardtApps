{
  "name": "neckardt-apps",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @neckardt/web --",
    "db:types": "npm run db:types --workspace @neckardt/backend",
    "typecheck": "npm run db:types && npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "check": "npm run typecheck && npm test",
    "build": "npm run db:types && npm run build --workspace @neckardt/web --",
    "test:hosted": "npm run test:hosted --workspace @neckardt/web --",
    "test:staging": "npm run test:hosted --"
  }
}
